# Cache de import do Godot — regenerado sozinho ao abrir o projeto (~149 MB).
.godot/
# Builds exportados
/build/
*.tmp

# Python
__pycache__/
*.pyc

# Logs
*.log

# Sistema
.DS_Store
Thumbs.db

# log do lançador do editor de animação
tools/anim_editor/abrir.log

# modelos largados para rigar (entrada local, não versiona)
assets/models/inbox/*
!assets/models/inbox/.gitkeep
assets/models/environment/sol3D.glb
art_src/blender/*.blend1

# Worktrees de agente (isolamento). Ficam DENTRO do projeto e NÃO são do jogo:
# um `git add -A` as engole como repositório embutido, e o `checar_cache.sh`
# enxergaria o código meio-escrito delas como classe do projeto.
# Ver .claude/LEIA-ME.md.
.claude/worktrees/

# Clipes de diagnóstico gravados pelo tools/dev_tests/gravar_clipes.gd.
# São megabytes de vídeo regeráveis por um comando — não entram no histórico.
clipes_diagnostico/
