config_version=5

[application]
config/name="Estúdio de animação · Skills One Piece"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1380
window/size/viewport_height=860
window/size/window_width_override=1380
window/size/window_height_override=860
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.045, 0.055, 0.075, 1)

