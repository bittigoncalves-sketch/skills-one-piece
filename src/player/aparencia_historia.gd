static func normalizar(valor: Variant) -> Dictionary:
	var saida := {}
	for chave: String in OPCOES:
		var id: Variant = valor.get(chave, "original") if valor is Dictionary else "original"
		var valido: bool = id is String and (OPCOES[chave].has(id) or (chave == "estampa" and id_de_estampa_valido(id)))
		saida[chave] = id if valido else "original"
	return saida


static func original(valor: Dictionary) -> bool:
	for id: String in valor.values():
		if id != "original": return false
	return true


static func cor_cabelo(valor: Dictionary) -> Color:
	return Color(CORES_CABELO[normalizar(valor).cor_cabelo])


## Id de estampa = exatamente 16 caracteres hexadecimais minúsculos. É o ÚNICO formato que vira caminho de arquivo (`EstampasHistoria`): nada vindo de save ou
## de rede consegue sair da pasta das estampas com um id assim.
static func id_de_estampa_valido(id: Variant) -> bool:
	if not (id is String) or (id as String).length() != 16:
		return false
	for c in (id as String):
		if not (c in "0123456789abcdef"):
			return false
	return true


## Cor do sobretudo: a "cor da roupa" escolhida, ou o cinza-escuro da referência.
static func cor_do_sobretudo(valor: Dictionary) -> Color:
	var a := normalizar(valor)
	return Color(COR_DO_SOBRETUDO) if a.cor_roupa == "original" else Color(CORES_ROUPA[a.cor_roupa])


static func cor_do_conjunto(valor: Dictionary, original: String) -> Color:
	var a := normalizar(valor)
	return Color(original) if a.cor_roupa == "original" else Color(CORES_ROUPA[a.cor_roupa])


static func cor_do_moletom(valor: Dictionary) -> Color:
	var a := normalizar(valor)
	return Color(COR_DO_MOLETOM) if a.cor_roupa == "original" else Color(CORES_ROUPA[a.cor_roupa])


static func cor_da_calca(valor: Dictionary) -> Color:
	var a := normalizar(valor)
	return Color(COR_DA_CALCA_BRANCA) if a.cor_calca == "original" else Color(CORES_ROUPA[a.cor_calca])
